# --- app ---
APP_NAME=Rustavel
APP_IP=0.0.0.0
APP_PORT=3000
APP_ENV=dev
APP_DEBUG=true
APP_KEY=


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en

# --- database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test
DB_USERNAME=root
DB_PASSWORD=


# --- Session ---
SESSION_DRIVER=memory
SESSION_COOKIE=rustavel_session
SESSION_LIFETIME_MINUTES=120
# Enable in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-username
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="rustavel"


# --- HTTP ---
HTTP_MAX_BODY_SIZE=2097152
HTTP_TIMEOUT_SECS=30
HTTP_COMPRESSION=true
HTTP_CSRF_GUARD=true
# Enable only when served over HTTPS
HTTP_HSTS=false

# --- CORS (empty = disabled, same-origin only) ---
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECS=3600