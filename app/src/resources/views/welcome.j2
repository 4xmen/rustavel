        <h1>Welcome to Rustavel</h1>
        <h2> {{ title }} </h2>
        <p class="subtitle">
            Everything is ready. Get started now and build your application.
        </p>

        <div class="actions">
            <a href="#" class="btn btn-primary">Get Started</a>
            <a href="#" class="btn btn-secondary">Documentation</a>
        </div>

        <div class="links">
            <a href="#">Documentation</a>
            <a href="https://github.com/4xmen/rustavel">Rustavel</a>
            <a href="https://github.com/4xmen/rustavel">GitHub</a>
        </div>
    </div>
    {% include "partials/dev/performance.j2" %}
</body>
</html>
